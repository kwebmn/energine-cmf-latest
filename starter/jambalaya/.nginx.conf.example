# nginx for an Energine 2.13 project with PHP-FPM 8.4+.
# Replace the server name, the project path and the PHP-FPM socket with yours.
server {
    listen 80;
    server_name example.com;
    root /var/www/my-site/htdocs;
    index index.php;
    client_max_body_size 64M;

    # dot-files, page and template XML/XSLT, PHP inside uploads are never served
    location ~ /\. { deny all; }
    location ~* \.(xml|xslt)$ { deny all; }
    location ~* ^/uploads/.*\.php$ { deny all; }

    # image resizer: /resizer/w200-h150/uploads/public/photo.jpg
    rewrite "^/resizer/w([0-9]+)-h([0-9]+)/(.*)$" /resizer/timthumb.php?w=$1&h=$2&src=$3&zc=2 last;

    # existing files as they are, every other address to Energine
    location / {
        try_files $uri @energine;
    }
    location @energine {
        rewrite ^ /index.php last;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
    }
}
