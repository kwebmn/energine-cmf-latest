# Apache 2.4 for an Energine 2.13 project (mod_rewrite): put it into htdocs/.
# nginx (.nginx.conf.example) is the tested setup; these rules mirror it.
Options -Indexes +FollowSymLinks
DirectoryIndex index.php
RewriteEngine on

# dot-files, page and template XML/XSLT, PHP inside uploads are never served
RewriteRule "(^|/)\." - [F]
RewriteRule "\.(xml|xslt)$" - [F]
RewriteRule "^uploads/.*\.php$" - [F]

# image resizer: /resizer/w200-h150/uploads/public/photo.jpg
RewriteRule "^resizer/w([0-9]+)-h([0-9]+)/(.*)$" resizer/timthumb.php?w=$1&h=$2&src=$3&zc=2 [L]

# existing files as they are, every other address to Energine
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]
