<?xml version="1.0" encoding="UTF-8"?>
<content html_class="colset colset2">
    <container name="left" column="column" html_class="col col1">
        <container name="mainMenuContainer" block="beta" widget="widget">
            <component name="mainMenu" class="Energine\share\components\PageList">
                <params>
                    <param name="tags">menu</param>
                    <param name="recursive">1</param>
                    <param name="config">core/modules/share/config/MainMenu.component.xml</param>
                </params>
            </component>
        </container>
        <container name="leftAdBlock"/>
        <container name="goodsFilterContainer" block="beta" widget="static">
            <component name="goodsFilter" class="Energine\shop\components\GoodsFilter">
                <params>
                    <param name="bind">goodsList</param>
                    <param name="tableName">shop_goods_view</param>
                </params>
            </component>
        </container>
        <container name="sidebarBannerContainer" block="beta" widget="static">
            <component name="sidebarBanner" class="Energine\ads\components\Ads">
                <params>
                    <param name="type">sidebar</param>
                    <param name="limit">1</param>
                    <param name="order">rand</param>
                </params>
            </component>
        </container>
        <container name="currencyContainer" block="beta" widget="static">
            <component name="currencies" class="Energine\shop\components\Currencies"/>
        </container>
        <container name="compareContainer" block="beta" widget="static">
            <component name="goodsCompare" class="Energine\shop\components\GoodsCompare"/>
        </container>
        <container name="savedFiltersContainer" block="beta" widget="static">
            <component name="savedFilters" class="Energine\shop\components\SavedFilters"/>
        </container>
        <container name="cartContainer" block="beta" widget="static">
            <component name="cartInformer" class="Energine\shop\components\Cart">
                <params>
                    <param name="title">TXT_CART</param>
                </params>
            </component>
            <component name="wishlistInformer" class="Energine\shop\components\Wishlist">
                <params>
                    <param name="title">TXT_WISHLIST</param>
                </params>
            </component>
        </container>
        <container name="loginFormContainer" block="beta" widget="widget">
            <component name="loginForm" class="Energine\user\components\LoginForm"/>
        </container>
    </container>
    <container name="center" column="column" html_class="col col2 last_col">
        <container name="goodsListContainer" block="alfa" widget="static">
            <component name="goodsSort" class="Energine\shop\components\GoodsSort">
                <params>
                    <param name="bind">goodsList</param>
                </params>
            </component>
            <component name="goodsList" class="Energine\shop\components\GoodsList">
                <params>
                    <param name="list_features">any</param>
                </params>
            </component>
            <component name="similarGoods" class="Energine\shop\components\RelatedGoodsList">
                <params>
                    <param name="bind">goodsList</param>
                    <param name="relation_type">similar</param>
                    <param name="title">TXT_SIMILAR_GOODS</param>
                </params>
            </component>
            <!-- аксессуары подгружаются после отрисовки страницы -->
            <component name="accessoryGoods" class="Energine\shop\components\AltRelatedGoodsList">
                <params>
                    <param name="bind">goodsList</param>
                    <param name="relation_type">accessory</param>
                    <param name="title">TXT_ACCESSORIES</param>
                </params>
            </component>
            <!-- список ранее просмотренных; идёт до регистратора, поэтому не содержит
                 товар, открытый прямо сейчас -->
            <component name="goodsLastSeenList" class="Energine\shop\components\GoodsLastSeenList"/>
            <!-- запоминает просмотренный товар -->
            <component name="goodsLastSeen" class="Energine\shop\components\GoodsLastSeen">
                <params>
                    <param name="bind">goodsList</param>
                </params>
            </component>
        </container>
    </container>
</content>
