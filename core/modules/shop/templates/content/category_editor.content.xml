<?xml version="1.0" encoding="UTF-8"?>
<content html_class="colset colset2">
    <container name="left" column="column" html_class="col col1">
        <container name="mainMenuContainer" block="beta" widget="widget">
            <component name="mainMenu" class="Energine\share\components\PageList">
                <params>
                    <param name="tags">menu</param>
                    <param name="recursive">1</param>
                    <param name="config">core/modules/share/config/MainMenu.component.xml</param>
                </params>
            </component>
        </container>
        <container name="leftAdBlock"/>
        <container name="loginFormContainer" block="beta" widget="widget">
            <component name="loginForm" class="Energine\user\components\LoginForm"/>
        </container>
    </container>
    <container name="center" column="column" html_class="col col2 last_col">
        <container name="smapSelector" block="alfa" widget="static">
            <component name="siteList" class="Energine\shop\components\SiteList">
                <params>
                    <param name="rights" type="hidden">3</param>
                    <param name="config" type="hidden">
                        <configuration>
                            <state name="main">
                                <fields>
                                    <field name="site_id" type="int"></field>
                                    <field name="site_name" type="string"></field>
                                    <field name="site_host" type="string"></field>
                                </fields>
                            </state>
                        </configuration>
                    </param>
                </params>
            </component>
            <component name="categoryDivEditor" class="Energine\shop\components\CategoryEditor">
                <params>
                    <param name="rights" type="hidden">3</param>
                    <param name="state" type="hidden">main</param>
                </params>
            </component>
        </container>
    </container>
</content>
