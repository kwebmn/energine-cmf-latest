<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Файл назывался SavedFilters.xml, поэтому конфиг не находился и компонент
         падал с ERR_DEV_NO_COMPONENT_CONFIG. Права были 3 (администратор),
         хотя фильтры принадлежат обычному пользователю. -->
    <state name="main">
        <fields>
            <field name="sf_id"/>
            <field name="sf_name"/>
            <field name="smap_id"/>
            <field name="sf_data"/>
        </fields>
        <translations>
            <translation const="TXT_SAVED_FILTERS"/>
            <translation const="BTN_DELETE"/>
        </translations>
    </state>
    <state name="delete">
        <uri_patterns>
            <pattern>/[int]/delete/</pattern>
        </uri_patterns>
    </state>
</configuration>
