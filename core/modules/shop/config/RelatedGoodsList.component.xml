<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- goods related to the viewed goods (shop_goods_relations), shown under the goods page -->
    <state name="main">
        <fields>
            <field name="goods_id"/>
            <field name="smap_id"/>
            <field name="goods_name"/>
            <field name="goods_segment"/>
            <field name="goods_price"/>
            <field name="sell_status_id" type="lookup"/>
            <field name="producer_id" type="lookup"/>
            <field name="attachments"/>
        </fields>
    </state>
</configuration>
