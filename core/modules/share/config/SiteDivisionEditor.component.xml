<?xml version="1.0" encoding="utf-8" ?>
<configuration extends="DivisionEditor.component.xml">
    <!-- отличия от DivisionEditor.component.xml: остальные состояния — как там -->
    <state name="showTransEditor" remove="1"/>
    <state name="showUserEditor" remove="1"/>
    <state name="showRoleEditor" remove="1"/>
    <state name="showLangEditor" remove="1"/>
    <state name="showSiteSettings" remove="1"/>
    <state name="showPageToolbar" remove="1"/>

    <state name="main" rights="3">
        <uri_patterns>
            <pattern>/show/</pattern>
        </uri_patterns>
        <javascript>
            <behavior name="DivManager"/>
        </javascript>
        <fields>
            <field name="smap_id"/>
            <field name="smap_pid"/>
            <field name="lang_id"/>
            <field name="smap_name"/>
        </fields>
        <toolbar name="e-divtree-toolbar">
            <control id="add" title="BTN_ADD" type="button" icon="add" onclick="add"/>
            <control id="edit" title="BTN_EDIT" type="button" icon="edit" onclick="edit"/>
            <control id="delete" title="BTN_DELETE" type="button" icon="delete" onclick="del"/>
            <!-- <control id="go" title="BTN_GO" type="button" onclick="go"/>-->
<!--             <control id="sep1" type="separator"/> -->
            <control id="up" title="BTN_MOVE_UP" type="button" icon="up" onclick="up"/>
            <control id="down" title="BTN_MOVE_DOWN" type="button" icon="down" onclick="down"/>
            <!-- <control id="sep2" type="separator"/>
                   <control id="close" title="BTN_ClOSE" type="button" onclick="close"/>-->
        </toolbar>
    </state>

    <state name="add" rights="3">
        <uri_patterns>
            <pattern>/add/[pid]/</pattern>
        </uri_patterns>
        <fields>
            <field name="smap_id"/>
            <field name="smap_pid" mode="1"/>
            <field name="lang_id"/>
            <field name="smap_content"/>
            <field name="smap_layout"/>
            <field name="smap_segment" pattern="/^[a-z0-9\-\.]*$/" message="TXT_BAD_SEGMENT_FORMAT"/>
            <field name="smap_redirect_url"/>
            <field name="smap_meta_robots"/>
            <field name="smap_in_menu"/>
            <field name="smap_is_disabled"/>
            <field name="smap_name"/>
            <field name="smap_title"/>
            <field name="smap_description_rtf"/>
            <field name="smap_html_title"/>
            <field name="smap_meta_keywords"/>
            <field name="smap_meta_description"/>
            <field name="page_rights" type="custom" tabName="trans(TAB_PAGE_RIGHTS)"/>
        </fields>
        <javascript>
            <behavior name="DivForm"/>
        </javascript>
        <toolbar>
            <control id="save" title="BTN_SAVE" type="button" onclick="save"/>
            <control id="after_save_action" title="TXT_AFTER_SAVE_ACTION" type="select">
                <options>
                    <option id="reload">BTN_CLOSE</option>
                    <option id="add">BTN_ADD</option>
                    <option id="go">BTN_GO</option>
                </options>
            </control>
            <control id="sep1" type="separator"/>
            <control id="list" title="BTN_CANCEL" type="button" onclick="close"/>
        </toolbar>
    </state>
</configuration>
