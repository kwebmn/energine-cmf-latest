<?xml version="1.0" encoding="utf-8" ?>
<configuration>
		<state name="main">
			<javascript>
				<behavior name="PageEditor"/>
			</javascript>
			<translations>
				<translation const="ERR_TEXT_NOT_SAVED"/>
				<translation const="BTN_HISTORY"/>
				<translation const="TXT_TEXT_HISTORY"/>
			</translations>
	    </state>
		<state name="save" rights="3">
			<uri_patterns>
				<pattern>/save-text/</pattern>
			</uri_patterns>
		</state>
		<state name="cleanup" rights="3">
			<uri_patterns>
				<pattern>/cleanup/</pattern>
			</uri_patterns>
		</state>
		<state name="imageManager" rights="3">
			<uri_patterns>
				<pattern>/imagemanager/</pattern>
			</uri_patterns>
		</state>
		<!-- Сквозной метод -->
		<state name="fileLibrary" rights="3">
			<uri_patterns>
				<pattern>/file-library/[any]/</pattern>
			</uri_patterns>
		</state>
		<!-- окно истории текста: грид версий (TextBlockHistory), его get-data, view и restore — под history/ -->
		<state name="history" rights="3">
			<uri_patterns>
				<pattern>/history/</pattern>
				<pattern>/history/[any]/</pattern>
			</uri_patterns>
		</state>

</configuration>