<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Разделы, в которых лежат новости. Создание и удаление разделов остаётся
         за редактором структуры, здесь правят только названия и описания. -->
    <state name="main">
        <fields>
            <field name="smap_id"/>
            <field name="smap_segment"/>
            <field name="smap_name"/>
        </fields>
        <javascript>
            <behavior name="GridManager"/>
        </javascript>
        <toolbar>
            <control id="edit" title="BTN_EDIT" type="button" onclick="edit"/>
        </toolbar>
    </state>
    <state name="edit" rights="3">
        <uri_patterns>
            <pattern>/[int]/edit/</pattern>
        </uri_patterns>
        <fields>
            <field name="smap_id"/>
            <field name="smap_segment" mode="1"/>
            <field name="smap_name"/>
            <field name="smap_title"/>
            <field name="smap_description_rtf"/>
        </fields>
        <javascript>
            <behavior name="Form"/>
        </javascript>
        <toolbar>
            <control id="save" title="BTN_SAVE" type="button" onclick="save"/>
            <control id="close" title="BTN_CLOSE" type="button" onclick="close"/>
        </toolbar>
    </state>
    <state name="save" rights="3">
        <uri_patterns>
            <pattern>/save/</pattern>
        </uri_patterns>
    </state>
    <state name="getRawData">
        <uri_patterns>
            <pattern>/get-data/</pattern>
            <pattern>/get-data/page-[pageNumber]/</pattern>
        </uri_patterns>
    </state>
</configuration>
