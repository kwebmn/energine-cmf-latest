<?xml version="1.0" encoding="utf-8" ?>
<configuration>
		<state name="main">
			<fields>
				<field name="u_name" title="FIELD_U_NAME"/>
			</fields>
		<toolbar>
			<control type="submit" id="send" title="BTN_SEND" />
		</toolbar>
		</state>
		<!-- запрос ссылки: ответ один для любого адреса -->
		<state name="send">
			<uri_patterns>
				<pattern>/send/</pattern>
			</uri_patterns>
			<fields>
				<field name="restore_password_result" mode="1"/>
			</fields>
		</state>
		<!-- переход по ссылке из письма: форма нового пароля -->
		<state name="reset">
			<uri_patterns>
				<pattern>/reset/[token]/</pattern>
			</uri_patterns>
			<fields>
				<field name="u_password" type="password" title="FIELD_U_PASSWORD"/>
				<field name="u_password2" type="password" title="FIELD_U_PASSWORD2"/>
			</fields>
			<toolbar>
				<control type="submit" id="change" title="BTN_SAVE" />
			</toolbar>
		</state>
		<state name="change">
			<uri_patterns>
				<pattern>/change/[token]/</pattern>
			</uri_patterns>
			<fields>
				<field name="restore_password_result" mode="1"/>
			</fields>
		</state>
</configuration>
