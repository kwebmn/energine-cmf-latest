{
  "name": "energine-cmf/energine",
  "description": "Energine is an XML/XSLT content management framework.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "xml",
    "xslt",
    "framework",
    "cmf"
  ],
  "homepage": "http://energine.net/",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-PDO": "*",
    "ext-pdo_mysql": "*",
    "ext-SimpleXML": "*",
    "ext-session": "*",
    "ext-xsl": "*"
  },
  "suggest": {
    "ext-tidy": "Cleans up HTML of text blocks when site.aggressive_cleanup is on (skipped without the extension)",
    "ext-zip": "Archives in the file repository",
    "ext-curl": "Remote images in the resizer",
    "ext-ftp": "FTP file repositories",
    "ext-iconv": "CSV export of grids in encodings other than UTF-8"
  },
